FROM node:22-alpine AS builder

# corepack enables pnpm as base node images do not have it
# pinned to 9.0.0 to match local pnpm version — using @latest caused version mismatch
# between local and container which broke .npmrc config reading
RUN corepack enable && corepack prepare pnpm@9.0.0 --activate

# install nestjs cli globally so nest build command is always available
# pnpm install --ignore-workspace does not reliably install devDependencies
# so @nestjs/cli was missing when pnpm build ran
RUN npm install -g @nestjs/cli

WORKDIR /api

# .npmrc must be copied before pnpm install runs
# it contains onlyBuiltDependencies[]=unrs-resolver which allows the build script to run
# without it pnpm blocks the script and exits with error
COPY package.json .npmrc ./

RUN pnpm install --ignore-workspace

COPY . .

# calls global nest cli directly instead of pnpm build
# avoids relying on local node_modules/@nestjs/cli being present
RUN nest build

FROM node:22-alpine AS production

# corepack needed in production stage too for pnpm to be available
# same version pin as builder stage
RUN corepack enable && corepack prepare pnpm@9.0.0 --activate

WORKDIR /app

# .npmrc needed here too as production stage runs its own pnpm install
COPY package.json .npmrc ./

# --prod installs only production dependencies, no devDependencies
# --ignore-workspace treats this as standalone project not part of monorepo
RUN pnpm install --prod --ignore-workspace

# copy compiled output from builder stage
# path must match builder WORKDIR which is /api
COPY --from=builder /api/dist ./dist

ENV PORT=3000

EXPOSE 3000

# run compiled js directly, no need for pnpm or typescript in production
CMD ["node", "dist/main"]
# node dist/main instead of pnpm start — runs the compiled JavaScript directly. No need for pnpm or TypeScript in the production container.


# Two stages — builder and production.
# The builder installs everything and compiles TypeScript. 
#The production stage starts fresh and only copies the compiled dist/ folder plus production dependencies. 
#Your devDependencies, TypeScript source files, and test files never make it into the final image.